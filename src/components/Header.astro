---
import HeaderLink from './HeaderLink.astro';
---

<header class="sticky top-0 z-50 bg-[#F8FAFC]/90 backdrop-blur-md border-b border-slate-200">
	<nav class="max-w-6xl mx-auto px-6 md:px-10 h-24 flex items-center justify-between">
		<a href="/" class="group flex items-center gap-3">
			<img src="/logo-no-bg.png" width="100" height="100" alt="The Cycling Dev Logo">
		</a>

		<div class="hidden md:flex items-center gap-10">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>

		<button
			id="nav-toggle"
			aria-label="Toggle navigation"
			aria-expanded="false"
			class="md:hidden p-2.5 -mr-2.5 rounded-md text-[#334155] hover:bg-slate-100  focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#334155] transition-colors"
		>
			<svg id="nav-open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6h16M4 12h16M4 18h16" /></svg>
			<svg id="nav-close" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M6 18L18 6M6 6l12 12" /></svg>
		</button>
	</nav>

	<div id="mobile-menu" class="hidden md:hidden bg-[#F8FAFC] border-t border-slate-200">
		<div class="px-6 py-2 flex flex-col">
			<HeaderLink href="/" class="py-4! min-h-12 flex items-center text-[15px]">Home</HeaderLink>
			<HeaderLink href="/blog" class="py-4! min-h-12 flex items-center text-[15px] border-t border-slate-100">Blog</HeaderLink>
			<HeaderLink href="/about" class="py-4! min-h-12 flex items-center text-[15px] border-t border-slate-100">About</HeaderLink>
		</div>
	</div>

	<script is:inline>
		(function(){
			const btn = document.getElementById('nav-toggle');
			const menu = document.getElementById('mobile-menu');
			const openIcon = document.getElementById('nav-open');
			const closeIcon = document.getElementById('nav-close');
			if (!btn) return;
			btn.addEventListener('click', ()=>{
				const nowHidden = menu.classList.toggle('hidden');
				btn.setAttribute('aria-expanded', String(!nowHidden));
				openIcon.classList.toggle('hidden', !nowHidden);
				closeIcon.classList.toggle('hidden', nowHidden);
			});
		})();
	</script>
</header>