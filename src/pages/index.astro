---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="max-w-4xl mx-auto px-6 py-20 md:py-32">
			<section>
				<p class="font-mono text-sm text-slate-500 tracking-tight mb-4">
					Software engineer &middot; road cyclist &middot; gear tested, not guessed
				</p>
				<h1 class="text-4xl md:text-5xl font-medium tracking-tight text-[#334155] leading-[1.1]">
					Code by day. Climb by dawn.
				</h1>
				<p class="mt-5 text-lg text-slate-600 leading-relaxed max-w-md">
					Deep dives on engineering practice, and honest notes on the bikes, components, and gear I actually ride — tested before they're recommended.
				</p>
				<div class="mt-8 flex flex-wrap items-center gap-4">
					<a
						href="/blog"
						class="inline-flex items-center gap-2 bg-[#334155] text-white text-sm font-medium px-5 py-3 rounded-md border border-[#334155] hover:bg-[#F8FAFC] hover:text-[#334155] transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ADFF2F]"
					>
						Read the blog
					</a>
					<a
						href="/blog?tag=gear"
						class="inline-flex items-center gap-2 text-sm font-medium text-[#334155] hover:text-[#334155] px-1 py-3 border-b border-transparent hover:border-[#ADFF2F] transition-colors duration-200"
					>
						See gear reviews →
					</a>
				</div>
			</section>

			<svg viewBox="0 0 100 8" preserveAspectRatio="none" class="w-full h-2 mt-20 mb-16 text-slate-200" aria-hidden="true">
				<path d="M0 6 L20 6 L26 2 L34 7 L42 3 L50 6 L100 6" fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke" />
			</svg>

			<section class="grid sm:grid-cols-2 gap-10">
				<div>
					<h2 class="text-lg font-medium tracking-tight text-[#334155]">Software Engineering</h2>
					<p class="mt-2 text-slate-600 leading-relaxed text-[15px]">
						Architecture decisions, debugging war stories, and the tools I reach for on real client work.
					</p>
					<a href="/blog?tag=engineering" class="mt-3 inline-block text-sm text-[#334155] border-b border-slate-300 hover:border-[#ADFF2F] transition-colors duration-200">
						Browse engineering posts →
					</a>
				</div>
				<div>
					<h2 class="text-lg font-medium tracking-tight text-[#334155]">Cycling &amp; Gear</h2>
					<p class="mt-2 text-slate-600 leading-relaxed text-[15px]">
						Component reviews, setup notes, and what's actually worth buying — with links to what I use.
					</p>
					<a href="/blog?tag=cycling" class="mt-3 inline-block text-sm text-[#334155] border-b border-slate-300 hover:border-[#ADFF2F] transition-colors duration-200">
						Browse cycling posts →
					</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>