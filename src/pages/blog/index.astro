---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const activeTag = Astro.url.searchParams.get('tag');
const posts = activeTag
	? allPosts.filter((post) => post.data.tags?.includes(activeTag as any))
	: allPosts;

const tagFilters = [
	{ label: 'All', value: null },
	{ label: 'Engineering', value: 'engineering' },
	{ label: 'Cycling', value: 'cycling' },
	{ label: 'Gear', value: 'gear' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="max-w-2xl mx-auto px-6 py-16 md:py-24">
			<div class="mb-10">
				<h1 class="text-2xl font-medium tracking-tight text-[#334155]">Blog</h1>
				<div class="flex flex-wrap gap-2 mt-5">
					{tagFilters.map((filter) => {
						const href = filter.value ? `/blog?tag=${filter.value}` : '/blog';
						const isActive = activeTag === filter.value;
						return (
							<a
								href={href}
								class:list={[
									'text-sm font-mono px-3 py-1.5 rounded-md border transition-colors duration-200',
									isActive
										? 'border-[#334155] text-[#334155] bg-slate-100'
										: 'border-slate-200 text-slate-500 hover:border-slate-300 hover:text-[#334155]',
								]}
							>
								{filter.label}
							</a>
						);
					})}
				</div>
			</div>

			{posts.length === 0 ? (
				<p class="text-slate-500 text-[15px]">No posts here yet — check back soon.</p>
			) : (
				<ul class="flex flex-col">
					{posts.map((post) => (
						<li class="border-t border-slate-200 last:border-b">
							<a
								href={`/blog/${post.id}/`}
								class="group flex items-center gap-5 py-6 min-h-12"
							>
								{post.data.heroImage && (
									<Image
										width={96}
										height={96}
										src={post.data.heroImage}
										alt=""
										class="w-20 h-20 object-cover rounded-md border border-slate-200 shrink-0 hidden sm:block"
									/>
								)}
								<div class="min-w-0">
									<p class="font-mono text-xs text-slate-500 mb-1.5">
										<FormattedDate date={post.data.pubDate} />
									</p>
									<h2 class="text-lg font-medium text-[#334155] leading-snug transition-colors duration-200 group-hover:text-[#8FD400]">
										{post.data.title}
									</h2>
									{post.data.tags?.length > 0 && (
										<div class="flex gap-1.5 mt-2">
											{post.data.tags.map((tag) => (
												<span class="text-[11px] font-mono text-slate-400">#{tag}</span>
											))}
										</div>
									)}
								</div>
							</a>
						</li>
					))}
				</ul>
			)}
		</main>
		<Footer />
	</body>
</html>